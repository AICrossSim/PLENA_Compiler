+def test_vector_candidate_machine_forms_are_distinct_and_canonical():
+    from compiler.aten.plena.vector_recurrence_candidate import (
+        VectorRecurrencePrimitive as P, VectorRecurrenceConfig,
+        encode_vector_recurrence,
+    )
+    assert VectorRecurrenceConfig(32, 128, 4, 96).pack() == (63, 4 | 96 << 3)
+    for form in (4, 5, 6):
+        word = encode_vector_recurrence(form=form, dst_register=0,
+                                      src1_register=12, src2_register=13)
+        assert word & 0x3f == 0x3f
+        assert word >> 22 == form
+    for primitive in P:
+        word = encode_vector_recurrence(form=6, dst_register=9,
+                                      src1_register=10, src2_register=11,
+                                      primitive=primitive)
+        assert (word >> 18) & 15 == primitive
+    for bad in ((33, 64, 4, 0), (2, 64, 2, 0), (32, 128, 4, 97), (1, 32, 1, 0)):
+        with pytest.raises(ValueError):
+            VectorRecurrenceConfig(*bad).pack()
+
