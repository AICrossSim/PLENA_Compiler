+def test_vector_candidate_assembler_keeps_cfg_and_exec_operand_placement(tmp_path):
+    from pathlib import Path
+    from assembler.assembly_to_binary import AssemblyToBinary
+    from assembler.parser import parse_asm_file
+    root = Path(__file__).resolve().parents[2]
+    assembler = AssemblyToBinary(str(root / 'doc/operation.svh'), str(root / 'doc/configuration.svh'))
+    source = tmp_path / 'candidate.asm'
+    source.write_text('V_REC_CFG 0, gp12, gp13\nV_REC_CCFG 2, gp12, gp13\nV_REC_EXEC gp9, gp10, gp11, 1\n')
+    words = [assembler._convert_to_binary(i) for i in parse_asm_file(str(source))]
+    assert words == [0x3f | 12 << 6 | 13 << 10 | 4 << 22,
+                     0x3f | 12 << 6 | 13 << 10 | 2 << 14 | 5 << 22,
+                     0x3f | 9 << 6 | 10 << 10 | 11 << 14 | 1 << 18 | 6 << 22]
