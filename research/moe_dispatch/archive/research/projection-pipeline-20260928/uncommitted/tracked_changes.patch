+@pytest.mark.parametrize('kind', ('mamba', 'kda'))
+@pytest.mark.parametrize('level', (2, 3, 4))
+def test_vector_candidate_never_reads_matrix_and_kda_preserves_original_state(kind, level):
+    from compiler.aten.plena.vector_recurrence_candidate import lower_vector_candidate_group
+    from compiler.aten.plena.mview import validate_matrix_view_dominance
+    native = ([(0x800000, 0, 1, 0, 0), (0x801000, 0, 128, 1, 3),
+               (0x801000, 1024, 128, 1, 3)] if kind == 'mamba' else
+              [(0x800000+i*4096, 0, 128, 1, 0) for i in range(3)])
+    assembly = lower_vector_candidate_group(
+        kind, level=level, state_base=0x100000, input_base=0x900000,
+        output_base=0xA00000, zero_base=0xB00000, scalar_base=0x901000,
+        skip_base=0x902000, native=native,
+    )
+    validate_matrix_view_dominance(assembly)
+    assert '.MV' not in assembly and 'L_TILE_' not in assembly
+    assert ('V_REC_EXEC gp9, gp10, gp11, 4' in assembly) == (level >= 3)
+    # Exactly 128 state stores, plus one result; KDA reads its ORIGINAL state
+    # in both scans without writing a rounded decayed intermediate.
+    assert assembly.count('H_STORE_V ') == 129
+    assert assembly.count('H_PREFETCH_V ') == (134 if kind == 'mamba' else 262)
+    missing = '\n'.join(line for line in assembly.splitlines() if not line.startswith('V_REC_CCFG'))
+    with pytest.raises(ValueError, match='Vector coefficient'):
+        validate_matrix_view_dominance(missing)
+
