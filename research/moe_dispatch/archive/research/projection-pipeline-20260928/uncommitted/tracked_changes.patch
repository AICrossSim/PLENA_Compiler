+def _lower_matrix_projection_single(p: Projection, inputs=None, outputs=None, *, vector_rows=58, transpose=True):
+    """Four-request existing M_MM/M_TMM on the bounded 4xK1024 array.
+
+    Direct rectangular tile base, not the legacy MLEN-square column-offset
+    ABI. The common Matrix-view substrate is required. No new opcode, cache,
+    replay latch, slice selector, segmented tree or uncharged DMA overlap.
+    M_MM row-major packets retain required N32 bank-word padding; M_TMM uses
+    four compact output rows and avoids that padding. Dummy request rows and
+    output tails are explicit zeros. One 4x4 partial tile survives K chunks.
+    """
+    from compiler.aten.plena.ltile_v2 import Emitter, View
+    from compiler.aten.plena.mview import (
+        MatrixViewAllocation, MatrixViewDescriptor, MatrixViewShape,
+        MatrixViewMap, validate_disjoint_matrix_views,
+    )
+    if any(type(v) is not int or v < 0 for v in vars(p).values()):
+        raise ValueError("nonnegative integer projection arguments required")
+    if p.mlen != 2048 or p.blen != 32 or min(p.k, p.n) < 1 or p.k_tile not in (256, 512, 1024):
+        raise ValueError("bounded batch Matrix requires V2048, bank word32, K256/512/1024")
+    inputs = (p.inputs,) if inputs is None else tuple(inputs)
+    outputs = (p.outputs,) if outputs is None else tuple(outputs)
+    if not 1 <= len(inputs) <= 16 or len(inputs) != len(outputs):
+        raise ValueError("one private input/output per request, batch 1..16")
+    batch = (len(inputs)+3)//4*4
+    if type(vector_rows) is not int or not batch+4 <= vector_rows <= 64:
+        raise ValueError("bounded Matrix input/output rows exceed Vector workspace")
+    starts = tuple(range(0, p.k, p.k_tile))
+    views = []
+    for i, k0 in enumerate(starts):
+        k = (min(p.k_tile, p.k-k0)+31)//32*32
+        if transpose:
+            cols = p.mlen//p.k_tile
+            base = (i//cols)*4*p.mlen+(i%cols)*p.k_tile
+            shape, mapping = MatrixViewShape(4, k), MatrixViewMap(4)
+        else:
+            base = i*32
+            shape, mapping = MatrixViewShape(k, 32), MatrixViewMap(k)
+        views.append(View(base, MatrixViewDescriptor(shape, mapping)))
+    validate_disjoint_matrix_views(
+        [MatrixViewAllocation(str(i), v.base, v.descriptor) for i,v in enumerate(views)],
+        mlen=2048, banks=64, bank_width=32, depth_rows=256,
+    )
+    # This schedule keeps an entire N4 panel resident. Row-major K>256 needs
+    # more physical rows than the SRAM has and must fail closed, not truncate.
+    weight_bytes = sum(v.descriptor.shape.rows*v.descriptor.shape.cols*2 for v in views)*((p.n+3)//4)
+    spans = [(x,p.input_values*2) for x in inputs]+[(x,p.output_values*2) for x in outputs]
+    spans += [(p.weights,weight_bytes),(p.zero,p.mlen*2)]
+    for i,(base,size) in enumerate(spans):
+        if type(base) is not int or base<0 or base%64 or base+size>2**32 or any(base<b+n and b<base+size for b,n in spans[:i]):
+            raise ValueError("unaligned, overlapping or overflowing projection allocations")
+    e = Emitter()
+    e.lines.append(f"; @software_projection {'M_TMM' if transpose else 'M_MM'} K={p.k_tile} batch={batch} vector_rows={vector_rows}")
+    def transfer(row, address, store=False):
+        e.address(1,row*p.mlen); e.address(2,address)
+        e.lines.append(f"H_{'STORE' if store else 'PREFETCH'}_V gp1, gp2, a0, 0, 2")
+    # Rows0..3 are transient; rows4..4+batch contain private output rows.
+    # Cache complete groups of four input rows in the remaining existing SRAM.
+    cache = {}
+    for k0 in starts:
+        for first in range(0,batch,4):
+            row = batch+4+len(cache)*4
+            if row+4 <= vector_rows:
+                cache[first,k0] = row
+                for j in range(4):
+                    transfer(row+j,inputs[first+j]+k0*2 if first+j<len(inputs) else p.zero)
+    address = p.weights
+    for row0 in range(0,p.n,p.mlen):
+        for r in range(batch):
+            transfer(4+r,p.zero)
+        for col in range(row0,min(row0+p.mlen,p.n),4):
+            for v in views:
+                e.dma(v,address)
+                address += v.descriptor.shape.rows*v.descriptor.shape.cols*2
+            for first in range(0,batch,4):
+                for v,k0 in zip(views,starts):
+                    row = cache.get((first,k0),0)
+                    if row == 0:
+                        for j in range(4):
+                            transfer(j,inputs[first+j]+k0*2 if first+j<len(inputs) else p.zero)
+                    e.view(0,v.descriptor)
+                    e.address(1,v.base); e.address(2,row*p.mlen)
+                    e.lines.append("M_TMM 0, gp2, gp1, 0" if transpose else "M_MM 0, gp1, gp2, 0")
+                e.address(1,(4+first)*p.mlen+col-row0)
+                e.lines.append("M_MM_WO gp1, a0, 0")
+        for r,destination in enumerate(outputs):
+            transfer(4+r,destination+row0*2,True)
+    return "\n".join(e.lines)+"\n"
+
+
+def lower_matrix_projection(p: Projection, inputs=None, outputs=None, *, vector_rows=58, transpose=True):
+    """Bounded batch GEMM with software-owned input residency and N panels.
+
+    Transpose uses N32 panels composed of eight existing N4 tiles. Four output
+    rows and four transient input rows suffice even at B16. Remaining Vector
+    rows hold the current four-request K chunks. Output row reload/store at
+    each N panel is explicit: no hidden partial bank or new slice hardware.
+    Row-major M_MM keeps its required padded-bank-word diagnostic template.
+    """
+    if not transpose:
+        return _lower_matrix_projection_single(p,inputs,outputs,vector_rows=vector_rows,transpose=False)
+    from compiler.aten.plena.ltile_v2 import Emitter, View
+    from compiler.aten.plena.mview import (
+        MatrixViewAllocation, MatrixViewDescriptor, MatrixViewShape,
+        MatrixViewMap, validate_disjoint_matrix_views,
+    )
+    if any(type(v) is not int or v<0 for v in vars(p).values()) or p.mlen!=2048 or p.blen!=32 or min(p.k,p.n)<1 or p.k_tile not in (256,512,1024):
+        raise ValueError("bounded matrix projection requires positive K/N, V2048, bank32, K256/512/1024")
+    inputs=(p.inputs,) if inputs is None else tuple(inputs)
+    outputs=(p.outputs,) if outputs is None else tuple(outputs)
+    if not 1<=len(inputs)<=16 or len(inputs)!=len(outputs) or type(vector_rows) is not int or not 8<=vector_rows<=64:
+        raise ValueError("invalid private requests or Vector workspace")
+    starts=tuple(range(0,p.k,p.k_tile))
+    # If every request/K window fits, retain them across all N4 panels and
+    # commit each output row once. Otherwise bound live requests to four and
+    # retain the widest legal N panel, charging output row reloads explicitly.
+    physical_batch=(len(inputs)+3)//4*4
+    if physical_batch+4+physical_batch*len(starts)<=vector_rows:
+        return _lower_matrix_projection_single(p,inputs,outputs,vector_rows=vector_rows,transpose=True)
+    columns=p.mlen//p.k_tile
+    panels=min(64,256//4*columns//len(starts))
+    if panels<1:
+        raise ValueError("one complete N4 weight panel exceeds Matrix SRAM")
+    panels=1<<(panels.bit_length()-1)
+    panel_n=panels*4
+    views=[]
+    for tile in range(panels):
+        group=[]
+        for j,k0 in enumerate(starts):
+            i=tile*len(starts)+j
+            k=(min(p.k_tile,p.k-k0)+31)//32*32
+            group.append(View((i//columns)*4*p.mlen+(i%columns)*p.k_tile,
+                MatrixViewDescriptor(MatrixViewShape(4,k),MatrixViewMap(4))))
+        views.append(group)
+    validate_disjoint_matrix_views([MatrixViewAllocation(str(i),v.base,v.descriptor)
+        for i,v in enumerate(v for group in views for v in group)],mlen=2048,banks=64,bank_width=32,depth_rows=256)
+    weight_bytes=sum(4*((min(p.k_tile,p.k-k0)+31)//32*32)*2 for k0 in starts)*((p.n+3)//4)
+    spans=[(x,p.input_values*2) for x in inputs]+[(x,p.output_values*2) for x in outputs]+[(p.weights,weight_bytes),(p.zero,p.mlen*2)]
+    for i,(base,size) in enumerate(spans):
+        if type(base) is not int or base<0 or base%64 or base+size>2**32 or any(base<b+n and b<base+size for b,n in spans[:i]):
+            raise ValueError("projection buffers are unaligned, overlapping or overflowing")
+    e=Emitter();e.lines.append(f"; @software_projection M_TMM K={p.k_tile} Npanel={panel_n} vector_rows={vector_rows}")
+    def transfer(row,address,store=False):
+        e.address(1,row*p.mlen);e.address(2,address)
+        e.lines.append(f"H_{'STORE' if store else 'PREFETCH'}_V gp1, gp2, a0, 0, 2")
+    cached_chunks=min(len(starts),(vector_rows-8)//4)
+    input_owner=None
+    address=p.weights
+    for col0 in range(0,p.n,panel_n):
+        # Panels must not cross a Vector output row boundary.
+        active_tiles=min(panels,(p.n-col0+3)//4,(p.mlen-col0%p.mlen)//4)
+        active_views=views[:active_tiles]
+        for group in active_views:
+            for v in group:
+                e.dma(v,address)
+                address+=v.descriptor.shape.rows*v.descriptor.shape.cols*2
+        for first in range(0,len(inputs),4):
+            if input_owner!=first:
+                for j,k0 in enumerate(starts[:cached_chunks]):
+                    for r in range(4):
+                        transfer(8+j*4+r,inputs[first+r]+k0*2 if first+r<len(inputs) else p.zero)
+                input_owner=first
+            row0=col0//p.mlen*p.mlen
+            for r in range(4):
+                transfer(4+r,outputs[first+r]+row0*2 if col0%p.mlen and first+r<len(inputs) else p.zero)
+            for tile,group in enumerate(active_views):
+                for j,(v,k0) in enumerate(zip(group,starts)):
+                    row=8+j*4 if j<cached_chunks else 0
+                    if row==0:
+                        for r in range(4):
+                            transfer(r,inputs[first+r]+k0*2 if first+r<len(inputs) else p.zero)
+                    e.view(0,v.descriptor);e.address(1,v.base);e.address(2,row*p.mlen)
+                    e.lines.append("M_TMM 0, gp2, gp1, 0")
+                e.address(1,4*p.mlen+col0%p.mlen+tile*4)
+                e.lines.append("M_MM_WO gp1, a0, 0")
+            for r in range(min(4,len(inputs)-first)):
+                transfer(4+r,outputs[first+r]+row0*2,True)
+    return '\n'.join(e.lines)+'\n'
