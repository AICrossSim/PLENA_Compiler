+@pytest.mark.parametrize('kind', ('mamba', 'kda'))
+def test_fused_expanded_candidate_still_executes_ordinary_software_expansion(kind):
+    from compiler.aten.plena.recurrent_coefficients import CompactCoefficientLoader
+    from compiler.aten.plena.vector_recurrence_candidate import lower_vector_candidate_group
+    from compiler.aten.plena.mview import validate_matrix_view_dominance
+    width, heads = (64, 32) if kind == 'mamba' else (128, 16)
+    mapping = {}
+    if kind == 'mamba':
+        for field, source in (('a', 0x800000), ('dt', 0x801000), ('d', 0x802000)):
+            mapping[field, 0] = [(source, h, h * width, width) for h in range(heads)]
+        for r in range(128):
+            for field, offset in (('b', 0), ('c', 1024)):
+                mapping[field, r] = [(0x803000, offset + h // 8 * 128 + r, h * width, 512)
+                                     for h in range(0, heads, 8)]
+    else:
+        mapping['beta', 0] = [(0x804000, h, h * width, width) for h in range(heads)]
+        for r in range(128):
+            for i, field in enumerate(('decay', 'key', 'query')):
+                mapping[field, r] = [(0x800000 + i * 4096, h * 128 + r, h * width, width)
+                                     for h in range(heads)]
+    intervals = sorted({(start, count) for values in mapping.values() for _, _, start, count in values})
+    loader = CompactCoefficientLoader(mapping, {key: 0xC00000 + i * 4096 for i, key in enumerate(intervals)}, 0xD00000)
+    assembly = lower_vector_candidate_group(kind, level=1, state_base=0x100000,
+        input_base=0x900000, output_base=0xA00000, zero_base=0xB00000,
+        coefficient_loader=loader)
+    validate_matrix_view_dominance(assembly)
+    assert 'V_SHFT_V' in assembly and 'V_RED_SUM' in assembly
+    assert '.MV' not in assembly and 'L_TILE_' not in assembly
+    assert assembly.count('H_STORE_V ') == 129
+    assert 'V_REC_EXEC gp9, gp10, gp11, 9' in assembly if kind == 'mamba' else True
