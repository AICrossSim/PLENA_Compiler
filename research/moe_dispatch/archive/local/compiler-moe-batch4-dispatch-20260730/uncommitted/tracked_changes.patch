+_TOPK_POLICY_REGISTER_RMASK = 15
+_TOPK_POLICY_EXPERT_SHIFT = 8
+_RTL_TOPK_MAX_EXPERTS = 256
+_RTL_TOPK_MAX_K = 8
+
+
+def _pack_rtl_topk_policy(num_experts: int, top_k: int) -> int:
+    """Pack the sticky RTL TopK policy after enforcing implemented limits."""
+    if not 0 < top_k <= num_experts:
+        raise ValueError(f"top_k={top_k} must be in [1, num_experts={num_experts}]")
+    if num_experts > _RTL_TOPK_MAX_EXPERTS or top_k > _RTL_TOPK_MAX_K:
+        raise NotImplementedError(
+            "RTL V_TOPK currently supports at most "
+            f"{_RTL_TOPK_MAX_EXPERTS} experts/top-{_RTL_TOPK_MAX_K}; "
+            f"got {num_experts}/top-{top_k}"
+        )
+    return (num_experts << _TOPK_POLICY_EXPERT_SHIFT) | top_k
+
+
+def _rtl_topk_policy(num_experts: int, top_k: int) -> tuple[int, int | None]:
+    fixed = {(32, 4): 0, (128, 8): 1}.get((num_experts, top_k))
+    if fixed is not None:
+        return fixed, None
+    return _TOPK_POLICY_REGISTER_RMASK, _pack_rtl_topk_policy(num_experts, top_k)
+
 
