+def test_shared_expert_gate_scales_rows_without_materializing_a_matrix():
+    """Qwen shared-expert output should consume gate scalars through V_MUL_VF."""
+    from compiler.aten.plena import PlenaCompiler
+
+    prog = PlenaCompiler(mlen=8, blen=4, unroll_loops=True, mram_tile_capacity=1)
+    constants = tuple(
+        prog.fp_var(name, size=4)
+        for name in ("zero", "unused_pos", "unused_neg", "one", "neg_one")
+    )
+    gate_scalars = prog.fp_var("shared_gate_scalars", size=4)
+    zero_row = prog.fp_var("zero_row", size=16)
+    x_input = prog.input("X", shape=(4, 16), physical_shape=(8, 16))
+    gate_row_input = prog.input("W_shared_gate_row", shape=(1, 16), physical_shape=(8, 16))
+    weights = (
+        prog.input("W_gate", shape=(16, 16)),
+        prog.input("W_up", shape=(16, 16)),
+        prog.input("W_down", shape=(16, 16)),
+    )
+    x = prog.load_batch(x_input, name="X")
+    gate_row = prog.load_batch(gate_row_input, name="W_shared_gate_row")
+    prog.moe_shared_expert_v0(
+        x,
+        weights,
+        rows=4,
+        intermediate=16,
+        constants=constants,
+        gate_weight_row=gate_row,
+        gate_fp_scratch=gate_scalars,
+        zero_row=zero_row,
+        policy_name="qwen2_moe",
+    )
+    code = prog.get_code()
+
+    assert "S_MAP_V_FP" not in code
+    assert "scale shared output token 0" in code
+    assert code.count("scale shared output token") == 4
+    # Four active rows across two MLEN-wide column blocks.
+    assert code.count("V_MUL_VF") >= 8
+    print("  PASS test_shared_expert_gate_scales_rows_without_materializing_a_matrix")
+
+
+def test_shared_gate_public_api_still_materializes_a_vram_matrix():
+    """Keep the PR's public matrix-returning gate helper backward compatible."""
+    from compiler.aten.plena import PlenaCompiler
+
+    prog = PlenaCompiler(mlen=8, blen=4, unroll_loops=True)
+    constants = tuple(
+        prog.fp_var(name, size=4)
+        for name in ("zero", "unused_pos", "unused_neg", "one", "neg_one")
+    )
+    gate_scalars = prog.fp_var("shared_gate_scalars", size=4)
+    zero_row = prog.fp_var("zero_row", size=8)
+    x_input = prog.input("X", shape=(4, 8), physical_shape=(8, 8))
+    gate_row_input = prog.input("W_shared_gate_row", shape=(1, 8), physical_shape=(8, 8))
+    x = prog.load_batch(x_input, name="X")
+    gate_row = prog.load_batch(gate_row_input, name="W_shared_gate_row")
+
+    gate_matrix = prog.moe_shared_gate_v0(
+        x,
+        gate_row,
+        rows=4,
+        hidden=8,
+        constants=constants,
+        gate_fp_scratch=gate_scalars,
+        zero_row=zero_row,
+    )
+
+    assert gate_matrix.shape == (4, 8)
+    assert "S_MAP_V_FP" in prog.get_code()
+    print("  PASS test_shared_gate_public_api_still_materializes_a_vram_matrix")
+
